# Browser-safe Supabase configuration
# These values are embedded in the browser bundle and must never be service-role keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Browser-safe TomTom Maps SDK key.
# Restrict this key to the deployed web origins in TomTom.
VITE_TOMTOM_MAP_API_KEY=your-tomtom-browser-map-key

# Browser-safe Paystack public key. Never place the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_or_pk_live_public_key

# Server-only configuration. Configure these in Vercel/host environment settings,
# not in client-exposed VITE_* variables and never commit their values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TOMTOM_API_KEY=your-tomtom-server-key
PAYSTACK_SECRET_KEY=sk_test_or_sk_live_secret_key

# Optional server/runtime settings.
APP_BASE_URL=https://your-production-domain.example
NODE_ENV=production
