{
  "name": "eventverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src api",
    "test": "vitest run",
    "cap:sync": "pnpm run build && cap sync",
    "cap:open:android": "cap open android",
    "android:release": "pnpm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "android:validate": "cd android && ./gradlew bundleRelease --stacktrace"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tomtom-org/maps-sdk": "^0.51.3",
    "@vitejs/plugin-react": "latest",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "vitest": "^4.1.11"
  }
}
